#!/usr/bin/env python3
"""Forward commands to Obsidian's native CLI socket on Arch Linux."""
import json, os, pathlib, select, socket, subprocess, sys, time
import termios, tty

if len(sys.argv) == 1 and not sys.stdin.isatty():
    args = ['--help']
else:
    args = sys.argv[1:]
if args and args[0] == 'help':
    args = args[1:] + ['--help']
if args == ['--desktop']:
    os.execv('/usr/bin/obsidian', ['/usr/bin/obsidian'])
address = str(pathlib.Path(os.environ.get('XDG_RUNTIME_DIR', str(pathlib.Path.home()))) / '.obsidian-cli.sock')
s = None
for attempt in range(100):
    candidate = socket.socket(socket.AF_UNIX)
    try:
        candidate.connect(address)
        s = candidate
        break
    except OSError:
        candidate.close()
        if attempt == 0:
            subprocess.Popen(['/usr/bin/obsidian'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        time.sleep(.2)
if s is None:
    sys.exit('Could not connect to Obsidian CLI within 20 seconds.')
interactive = sys.stdin.isatty() and sys.stdout.isatty()
s.sendall((json.dumps({'argv': args, 'tty': interactive, 'cwd': os.getcwd()}) + '\n').encode())
previous = None
try:
    if interactive:
        previous = termios.tcgetattr(sys.stdin.fileno())
        tty.setraw(sys.stdin.fileno())
    while True:
        inputs = [s, sys.stdin] if interactive else [s]
        ready, _, _ = select.select(inputs, [], [])
        if s in ready:
            data = s.recv(65536)
            if not data:
                break
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()
        if interactive and sys.stdin in ready:
            data = os.read(sys.stdin.fileno(), 4096)
            if not data:
                break
            s.sendall(data)
finally:
    if previous is not None:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, previous)
    s.close()
